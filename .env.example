# 复制为 .env 并替换全部密钥。生产部署必须替换所有 <random> 值。
# 中国网络构建镜像时可设置：NPM_PROXY=http://host.docker.internal:7890
NPM_PROXY=
# ============ 应用 ============
API_PORT=4001
APP_SESSION_SECRET=<random-64-hex>
MODEL_CONFIG_ENCRYPTION_KEY=<random-32-byte-hex>   # AES-256-GCM 主密钥，openssl rand -hex 32
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=<random>

# ============ 数据库 / 队列 / 文件 ============
APP_DATABASE_URL=postgresql://app:<password>@postgres:5432/app
REDIS_URL=redis://redis-app:6379
STORAGE_DRIVER=local
STORAGE_ROOT=/data/ai-customer-service

# ============ Langfuse（INIT 变量在首次启动时自动创建组织/项目/Key）============
LANGFUSE_BASE_URL=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=pk-lf-<same-as-init>
LANGFUSE_SECRET_KEY=sk-lf-<same-as-init>
LANGFUSE_INIT_ORG_ID=ai-customer-service
LANGFUSE_INIT_ORG_NAME=AI Customer Service
LANGFUSE_INIT_PROJECT_ID=production
LANGFUSE_INIT_PROJECT_NAME=Production
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-<generated>
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-<generated>
LANGFUSE_INIT_USER_EMAIL=langfuse-admin@example.com
LANGFUSE_INIT_USER_PASSWORD=<random>

# ============ 运行参数 ============
CHAT_RUN_TIMEOUT_SECONDS=180
QUEUE_FULL_LIMIT=20

# ============ Langfuse 基础设施密钥（compose 使用）============
POSTGRES_PASSWORD=<random>
CLICKHOUSE_PASSWORD=<random>
MINIO_ROOT_USER=langfuse-minio
MINIO_ROOT_PASSWORD=<random>
REDIS_LANGFUSE_AUTH=<random>
NEXTAUTH_SECRET=<random>
LANGFUSE_MIGRATION_V4_WRITE_MODE=dual
LANGFUSE_SALT=<random>
LANGFUSE_ENCRYPTION_KEY=<random-64-hex>
